{
  "name": "ac26_agents_wshop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ac26_agents_wshop,type=bind",
  "workspaceFolder": "/workspaces/ac26_agents_wshop",
  "remoteUser": "rstudio",
  "postCreateCommand": "bash .devcontainer/post_create.sh",
  "postStartCommand": "sudo rstudio-server start",
  "shutdownAction": "stopContainer",
  "forwardPorts": [
    8787
  ],
  "portsAttributes": {
    "8787": {
      "label": "RStudio"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "RDebugger.r-debugger",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "mechatroner.rainbow-csv",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/ac26_agents_wshop/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "r.rpath.linux": "/usr/local/bin/R",
        "r.lsp.path": "/usr/local/bin/R",
        "r.lsp.debug": false
      }
    }
  }
}
